# ─── Database (Neon PostgreSQL) ────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@host/db?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://user:password@host/db?sslmode=require

PGHOST=ep-solitary-dew-aokgiax8-pooler.c-2.ap-southeast-1.aws.neon.tech
PGHOST_UNPOOLED=ep-solitary-dew-aokgiax8.c-2.ap-southeast-1.aws.neon.tech
PGUSER=neondb_owner
PGDATABASE=neondb
PGPASSWORD=YOUR_PASSWORD

# ─── Auth ─────────────────────────────────────────────────────────────────────
# Change this in production: openssl rand -base64 48
AUTH_SECRET=generate-with-openssl-rand-base64-48
SESSION_MAX_AGE_DAYS=7

# ─── Application ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME=CoachDesk
NEXT_PUBLIC_DEFAULT_LOCALE=bn

# ─── SMS pipeline ─────────────────────────────────────────────────────────────
# Master kill switch. While false, nothing is dispatched: messages are queued
# and immediately marked "skipped" with reason "sms_disabled".
SMS_ENABLED=false
# Provider adapter to use once SMS_ENABLED=true. "noop" is the only one wired up.
SMS_PROVIDER=noop
SMS_SENDER_NAME=CoachDesk
